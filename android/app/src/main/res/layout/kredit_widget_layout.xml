<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget layout: black & white, matching Kredit's app theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kredit"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Deuda Total"
        android:textColor="#AAAAAA"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_total_debt_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Próximo pago"
        android:textColor="#AAAAAA"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_next_payment_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Sin pagos pendientes"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

</LinearLayout>
